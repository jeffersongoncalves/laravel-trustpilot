{
    "name": "jeffersongoncalves/laravel-trustpilot",
    "description": "A Laravel client for the Trustpilot API — business units, public and private reviews, replies, email invitations, and review tags.",
    "keywords": [
        "laravel",
        "trustpilot",
        "reviews",
        "ratings",
        "invitations",
        "reputation",
        "api",
        "client"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-trustpilot",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "jefferson@codions.com",
            "homepage": "https://github.com/jeffersongoncalves"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Trustpilot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Trustpilot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Trustpilot\\TrustpilotServiceProvider"
            ],
            "aliases": {
                "Trustpilot": "JeffersonGoncalves\\Trustpilot\\Facades\\Trustpilot"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
